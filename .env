# FastAPI
SECRET_KEY=

# Google OAuth (https://console.cloud.google.com/apis/credentials 에서 발급)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth redirect (Google Console의 승인된 리디렉션 URI와 일치해야 함)
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# PostgreSQL (docker-compose 기준)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5434/app

# Redis (docker-compose 기준)
REDIS_URL=redis://localhost:6380/0
